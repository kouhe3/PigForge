{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigforge.invalid/schemas/level-content-v2.schema.json",
  "title": "PigForge Level Content v2",
  "description": "Engine-agnostic level definition: spawn list, goal trigger zone, map bounds and the static triangle-mesh terrain the original bakes into each level. v2 adds `terrain`; v1 documents (no terrain) keep parsing. Per ADR-002 the level carries position triggers only; there is no damage or health data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "contentVersion", "goalZone", "bounds", "spawns"],
  "properties": {
    "format": { "const": "pigforge.level-content" },
    "schemaVersion": { "const": 2 },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "goalZone": { "$ref": "#/$defs/zone" },
    "bounds": { "$ref": "#/$defs/zone" },
    "spawns": {
      "type": "array",
      "items": { "$ref": "#/$defs/spawn" }
    },
    "terrain": {
      "description": "One entry per `e2dTerrain` object that carries a collider. `position` is the object's own transform (the original never rotates or scales these), `depth` is the extrusion along z (e2dConstants.COLLISION_MESH_Z_DEPTH = 10) and `loops` are the terrain's boundary polygons in its local frame, each point being [x, y] because the extrusion supplies z.",
      "type": "array",
      "items": { "$ref": "#/$defs/terrain" }
    }
  },
  "$defs": {
    "positiveUInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "finiteNumber": { "type": "number" },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "point2": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partTypeId", "position"],
      "properties": {
        "partTypeId": { "$ref": "#/$defs/positiveUInt" },
        "position": { "$ref": "#/$defs/vector3" },
        "angle": { "$ref": "#/$defs/finiteNumber" },
        "role": { "enum": ["part", "pig", "tnt"] },
        "tntFuseTicks": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "motorImpulsePerTick": { "$ref": "#/$defs/finiteNumber" },
        "motorDirectionX": { "enum": [-1, 0, 1] },
        "wheel": { "type": "boolean" }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "depth", "loops"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "loops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/point2" }
          }
        }
      }
    }
  }
}
